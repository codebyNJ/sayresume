# Cloud backend (OpenRouter; cheap paid models by default, a free one as last resort). Get a key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional
# CLOUD_MODELS=qwen/qwen3.7-flash,mistralai/mistral-small-3.2-24b-instruct,anthropic/claude-haiku-5.5,nvidia/nemotron-3.5-lightning:free
# Local backend (oMLX). Defaults shown; the oMLX key is read from ~/.omlx/settings.json
# LLM_MODEL=Qwen3.5-9B-4bit
# LLM_URL=http://127.0.0.1:8002/v1/chat/completions
# LLM_API_KEY=
# PORT=3000
